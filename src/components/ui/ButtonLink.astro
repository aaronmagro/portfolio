---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: Variant;
}

const { href, variant = 'primary', ...attributes } = Astro.props;
---

<a class:list={['button-link', `button-link--${variant}`]} href={href} {...attributes}>
  <slot />
</a>

<style>
  .button-link {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding-inline: var(--space-5);
    border: 1px solid var(--ink);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .button-link:hover {
    transform: translateY(-2px);
  }

  .button-link--primary {
    border-color: var(--mark-edge);
    background: var(--accent);
    color: var(--on-accent);
    clip-path: polygon(0.6rem 0, 100% 0, 100% calc(100% - 0.6rem), calc(100% - 0.6rem) 100%, 0 100%, 0 0.6rem);
  }

  .button-link--secondary {
    background: transparent;
    color: var(--ink);
  }

  .button-link--secondary:hover {
    border-color: var(--accent-ink);
    color: var(--accent-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .button-link:hover {
      transform: none;
    }
  }
</style>
