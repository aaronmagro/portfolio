---
interface Props {
  title: string;
  label?: string;
  headingId: string;
}

const { title, label, headingId } = Astro.props;
---

<header class="section-header">
  <h2 id={headingId}>{title}</h2>
  {label && <p class="section-header__label label">{label}</p>}
  <slot />
</header>

<style>
  .section-header {
    display: grid;
    grid-template-columns: 1fr;
    align-items: end;
    gap: var(--space-2) var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  .section-header h2 {
    grid-column: 1 / -1;
    font-size: var(--text-2xl);
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .section-header__label {
    grid-column: 1 / -1;
  }

  @media (min-width: 48rem) {
    .section-header {
      grid-template-columns: 1fr auto;
    }

    .section-header h2 {
      grid-column: 1;
    }

    .section-header__label {
      grid-column: 2;
      text-align: right;
    }
  }
</style>
