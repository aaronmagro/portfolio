---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  description?: string;
  headingId: string;
}

const { index, eyebrow, title, description, headingId } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<div class:list={['section-heading', { 'section-heading--with-aside': hasAside }]}>
  <div class="section-heading__meta" aria-hidden="true">
    <span>{index}</span>
    <span>{eyebrow}</span>
  </div>

  <div class="section-heading__body">
    <div class="section-heading__copy">
      <h2 id={headingId}>{title}</h2>
      {description && <p>{description}</p>}
    </div>

    {hasAside && (
      <div class="section-heading__aside">
        <slot name="aside" />
      </div>
    )}
  </div>
</div>

<style>
  .section-heading {
    display: grid;
    gap: var(--space-6);
  }

  .section-heading__meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .section-heading__meta span:first-child {
    min-width: 2ch;
  }

  .section-heading__body {
    display: grid;
    gap: var(--space-7);
  }

  .section-heading__copy {
    max-width: 48rem;
  }

  .section-heading h2 {
    font-size: var(--text-2xl);
    letter-spacing: -0.04em;
  }

  .section-heading p {
    max-width: 38rem;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .section-heading__aside {
    min-width: 0;
  }

  @media (min-width: 68rem) {
    .section-heading--with-aside .section-heading__body {
      grid-template-columns: minmax(0, 1fr) minmax(19rem, 0.62fr);
      align-items: end;
      gap: clamp(var(--space-8), 8vw, var(--space-10));
    }

    .section-heading__aside {
      justify-self: stretch;
      padding-bottom: 0.35rem;
    }
  }
</style>
