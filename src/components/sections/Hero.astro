---
import Container from '../ui/Container.astro';
import ButtonLink from '../ui/ButtonLink.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <Container>
    <div class="hero__layout">
      <div class="hero__content">
        <p class="hero__eyebrow">Lorem ipsum · Dolor sit</p>
        <h1 id="hero-title">Lorem ipsum dolor sit amet, consectetur.</h1>
        <p class="hero__lead">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer vitae lorem at sapien
          tincidunt luctus eget sed arcu.
        </p>

        <div class="hero__actions">
          <ButtonLink href="#projects">Lorem ipsum</ButtonLink>
          <ButtonLink href="#contact" variant="secondary">Dolor sit</ButtonLink>
        </div>

        <a class="hero__scroll" href="#projects">
          <span>Lorem ipsum</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 5v14m0 0 6-6m-6 6-6-6"></path>
          </svg>
        </a>
      </div>

      <div class="hero__visual" aria-hidden="true">
        <div class="hero__visual-grid"></div>
        <div class="hero__visual-frame">
          <div class="hero__visual-bar">
            <span>01</span>
            <span>Lorem</span>
          </div>

          <div class="hero__visual-core">
            <div class="hero__visual-orbit hero__visual-orbit--outer"></div>
            <div class="hero__visual-orbit hero__visual-orbit--inner"></div>
            <div class="hero__visual-disc"></div>
            <div class="hero__visual-node hero__visual-node--one"></div>
            <div class="hero__visual-node hero__visual-node--two"></div>
          </div>

          <div class="hero__visual-footer">
            <span>Dolor sit</span>
            <span>04 / 08</span>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .hero {
    display: grid;
    min-height: calc(100svh - 4.5rem);
    align-items: center;
    overflow: hidden;
    padding-block: clamp(var(--space-8), 10vh, var(--space-10));
  }

  .hero__layout {
    display: grid;
    align-items: center;
    gap: clamp(var(--space-7), 8vw, var(--space-10));
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 46rem;
  }

  .hero__eyebrow {
    margin-bottom: var(--space-5);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 11ch;
    font-size: var(--text-display);
    letter-spacing: -0.055em;
  }

  .hero__lead {
    max-width: 39rem;
    margin-top: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color var(--transition-fast);
  }

  .hero__scroll:hover {
    color: var(--color-heading);
  }

  .hero__scroll svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .hero__visual {
    position: relative;
    width: min(100%, 42rem);
    min-height: clamp(22rem, 58vw, 34rem);
    margin-inline: auto;
    isolation: isolate;
  }

  .hero__visual-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 3.5rem 3.5rem;
    mask-image: linear-gradient(to bottom, transparent, black 14%, black 82%, transparent);
    opacity: 0.5;
  }

  .hero__visual-frame {
    position: absolute;
    inset: 8% 0 0 8%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(145deg, rgb(255 255 255 / 0.035), transparent 42%),
      var(--color-surface);
    box-shadow: var(--shadow-elevated);
    overflow: hidden;
  }

  .hero__visual-frame::before {
    position: absolute;
    inset: 10% auto auto 8%;
    width: 8rem;
    height: 8rem;
    border-radius: 50%;
    background: var(--color-brand);
    content: '';
    filter: blur(5rem);
    opacity: 0.55;
  }

  .hero__visual-bar,
  .hero__visual-footer {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__visual-core {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(19rem, 66%);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
  }

  .hero__visual-orbit,
  .hero__visual-disc,
  .hero__visual-node {
    position: absolute;
    border-radius: 50%;
  }

  .hero__visual-orbit {
    border: 1px solid var(--color-border);
  }

  .hero__visual-orbit--outer {
    inset: 0;
  }

  .hero__visual-orbit--inner {
    inset: 18%;
    border-style: dashed;
    opacity: 0.7;
  }

  .hero__visual-disc {
    inset: 31%;
    background:
      radial-gradient(circle at 35% 30%, rgb(118 210 247 / 0.95), transparent 32%),
      linear-gradient(145deg, var(--color-brand), var(--color-brand-strong));
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 1.5rem 4rem rgb(0 0 0 / 0.32);
  }

  .hero__visual-node {
    width: 0.75rem;
    height: 0.75rem;
    border: 0.1875rem solid var(--color-surface);
    background: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-border);
  }

  .hero__visual-node--one {
    top: 11%;
    right: 15%;
  }

  .hero__visual-node--two {
    bottom: 16%;
    left: 9%;
  }

  @media (min-width: 68rem) {
    .hero__layout {
      grid-template-columns: minmax(0, 1.08fr) minmax(22rem, 0.92fr);
    }

    .hero__visual {
      width: 100%;
      min-height: 34rem;
      margin-inline: 0;
    }
  }

  @media (max-width: 67.9375rem) {
    .hero__content {
      max-width: 52rem;
    }

    .hero__visual-frame {
      inset-inline: 4%;
    }
  }

  @media (max-width: 35rem) {
    .hero {
      padding-block: var(--space-7) var(--space-8);
    }

    .hero__actions > :global(*) {
      width: 100%;
    }

    .hero__scroll {
      margin-top: var(--space-7);
    }

    .hero__visual {
      min-height: 21rem;
    }

    .hero__visual-frame {
      inset: 4% 0 0;
    }
  }
</style>
