---
import ThemedImage from '../ui/ThemedImage.astro';
import TechList from '../ui/TechList.astro';
import Container from '../ui/Container.astro';
import ButtonLink from '../ui/ButtonLink.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { projects } from '../../data/projects';
import { siteConfig, type SupportedLocale } from '../../config/site';
import { formatPeriod } from '../../utils/dates';

interface Props {
  lang?: SupportedLocale;
}

const { lang = siteConfig.defaultLocale } = Astro.props;

const copy = {
  es: {
    title: 'Proyectos',
    label: 'Hechos por mi cuenta, fuera de NTT DATA',
    mission: 'Misión',
    of: 'de',
    objectives: 'Qué hice',
    technologies: 'Tecnologías',
    caseStudy: 'Leer el caso de estudio',
  },
  en: {
    title: 'Projects',
    label: 'Built on my own, outside NTT DATA',
    mission: 'Mission',
    of: 'of',
    objectives: 'What I did',
    technologies: 'Technologies',
    caseStudy: 'Read the case study',
  },
} as const;

const text = copy[lang];
const [featured, ...others] = projects;
const total = String(projects.length).padStart(2, '0');
const number = (index: number) => String(index + 1).padStart(2, '0');
---

<section class="projects" id="projects" aria-labelledby="projects-title">
  <Container>
    <SectionHeader title={text.title} label={text.label} headingId="projects-title" />

    <article id={`project-${featured.id}`} class="featured" aria-labelledby={`project-${featured.id}-title`}>
      <div class="featured__visual">
        {featured.image && (
          <figure class="featured__media brackets" data-tilt>
            <ThemedImage image={featured.image} lang={lang} widths={[640, 960, 1440]} sizes="(min-width: 68rem) 55vw, 100vw" />
          </figure>
        )}
        <TechList items={featured.technologies} label={text.technologies} />
        <div class="featured__links">
          {featured.caseStudy && <ButtonLink href={featured.caseStudy[lang]}>{text.caseStudy}</ButtonLink>}
          {featured.links.map((link) => (
            <ButtonLink href={link.href} variant="secondary" target="_blank" rel="noopener">{link.label[lang]} ↗</ButtonLink>
          ))}
        </div>
      </div>

      <div class="featured__brief panel-cut">
        <p class="featured__meta label">
          <span class="featured__status"><span class="dot" aria-hidden="true"></span>{featured.kind[lang]}</span>
          <span>{text.mission} {number(0)} {text.of} {total}</span>
        </p>
        <h3 id={`project-${featured.id}-title`}>{featured.title[lang]}</h3>
        <p class="label">{formatPeriod(featured.startDate, featured.endDate, lang)}</p>
        <p class="featured__summary">{featured.summary[lang]}</p>

        <ul class="objectives" aria-label={text.objectives}>
          {featured.highlights.map((highlight) => <li>{highlight[lang]}</li>)}
        </ul>
      </div>
    </article>

    <div class="missions">
      {others.map((project, index) => (
        <article id={`project-${project.id}`} class="mission panel-cut" aria-labelledby={`project-${project.id}-title`}>
          {project.image && (
            <figure class="mission__media">
              <ThemedImage image={project.image} lang={lang} widths={[480, 720, 960]} sizes="(min-width: 48rem) 40vw, 100vw" />
            </figure>
          )}
          <div class="mission__body">
            <p class="mission__meta label">
              <span>{text.mission} {number(index + 1)}</span>
              <span>{project.kind[lang]}</span>
            </p>
            <h3 id={`project-${project.id}-title`}>{project.title[lang]}</h3>
            <p class="mission__summary">{project.summary[lang]}</p>
            <div class="mission__tech">
              <TechList items={project.technologies} label={text.technologies} size="sm" />
            </div>
            {project.links.length > 0 && (
              <p class="mission__links">
                {project.links.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener">{link.label[lang]} ↗</a>
                ))}
              </p>
            )}
          </div>
        </article>
      ))}
    </div>
  </Container>
</section>

<style>
  .projects {
    padding-block: clamp(var(--space-9), 10vw, var(--space-10));
    scroll-margin-top: 4.5rem;
  }

  .featured {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-8);
    scroll-margin-top: 6rem;
  }

  .featured__media {
    margin: 0;
    padding: var(--space-3);
    border: 1px solid var(--line);
    background: var(--panel);
    transition: transform 200ms ease-out, border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .featured__media:is(:hover, .is-tilted) {
    border-color: var(--accent-ink);
    box-shadow: inset 0 0 0 1px var(--accent-ink);
  }

  .featured__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .featured__visual {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .featured__visual .featured__links {
    margin-top: 0;
  }

  .featured__brief {
    --cut: 1.1rem;
    padding: var(--space-6);
  }

  .featured__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .featured__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--accent-ink);
    font-weight: 700;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent-ink);
    box-shadow: 0 0 0.6rem var(--accent);
  }

  .featured h3 {
    margin: var(--space-4) 0 var(--space-2);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    text-transform: uppercase;
  }

  .featured__summary {
    margin-top: var(--space-4);
    color: var(--soft);
  }

  .objectives {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .objectives li {
    position: relative;
    padding-left: var(--space-6);
  }

  .objectives li::before {
    position: absolute;
    top: 0.3em;
    left: 0;
    box-sizing: border-box;
    width: 16px;
    height: 16px;
    padding: 3px;
    border: 2px solid var(--accent-ink);
    background: var(--accent-ink) content-box;
    content: '';
  }



  .featured__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .missions {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .mission {
    --cut: 1rem;
    display: grid;
    grid-template-rows: auto 1fr;
    scroll-margin-top: 6rem;
  }

  /* Cards to read and click: they light up but stay still. */
  .mission:hover {
    --panel-border: 2px;
    --panel-line: var(--accent-ink);
  }

  .mission:hover .mission__media :global(img) {
    transform: scale(1.03);
  }

  .mission__media {
    margin: 2px 2px 0;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    clip-path: polygon(calc(var(--cut) - 2px) 0, 100% 0, 100% 100%, 0 100%, 0 calc(var(--cut) - 2px));
  }

  .mission__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform var(--transition-base);
  }

  .mission__body {
    display: flex;
    flex-direction: column;
    padding: var(--space-5) var(--space-6) var(--space-6);
  }

  .mission__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
  }

  .mission__meta span:first-child {
    color: var(--accent-ink);
    font-weight: 700;
    white-space: nowrap;
  }

  .mission h3 {
    margin-top: var(--space-3);
    font-size: 1.9rem;
    text-transform: uppercase;
  }

  .mission__summary {
    margin-top: var(--space-3);
    color: var(--soft);
    font-size: 0.95rem;
  }

  .mission__tech {
    margin-top: var(--space-4);
  }

  .mission__links {
    display: flex;
    gap: var(--space-5);
    margin-top: auto;
    padding-top: var(--space-5);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .missions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .featured {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mission__media :global(img) {
      transform: none !important;
    }
  }
</style>
