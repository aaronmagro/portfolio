---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { experienceCompanies } from '../../data/experience';
import { siteConfig } from '../../config/site';

type SupportedLocale = (typeof siteConfig.locales)[number];

interface Props {
  lang?: SupportedLocale;
}

const { lang = siteConfig.defaultLocale } = Astro.props;

const copy = {
  es: {
    eyebrow: 'Trayectoria profesional',
    title: 'Experiencia',
    description:
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer vitae lorem at sapien tincidunt luctus eget sed arcu.',
    stages: 'Etapas dentro de',
    highlights: 'Aspectos destacados',
    technologies: 'Tecnologías',
    timeline: 'Cronología profesional',
    explore: 'Explora por meses',
  },
  en: {
    eyebrow: 'Professional background',
    title: 'Experience',
    description:
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer vitae lorem at sapien tincidunt luctus eget sed arcu.',
    stages: 'Roles at',
    highlights: 'Highlights',
    technologies: 'Technologies',
    timeline: 'Professional timeline',
    explore: 'Explore by month',
  },
} as const;

const monthLabels = {
  es: ['ENE', 'FEB', 'MAR', 'ABR', 'MAY', 'JUN', 'JUL', 'AGO', 'SEPT', 'OCT', 'NOV', 'DIC'],
  en: ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'],
} as const;

const toMonthIndex = (value: string) => {
  const [year, month] = value.split('-').map(Number);
  return year * 12 + month - 1;
};

const currentDate = new Date();
const currentYearMonth = `${currentDate.getFullYear()}-${String(currentDate.getMonth() + 1).padStart(2, '0')}`;

const rawOverviewRoles = experienceCompanies.flatMap((company) =>
  company.roles.map((role) => ({
    key: `${company.id}-${role.id}`,
    role: role.role[lang],
    period: role.period[lang],
    startDate: role.startDate,
    endDate: role.endDate ?? currentYearMonth,
  })),
);

const timelineStartMonth = rawOverviewRoles.length
  ? Math.min(...rawOverviewRoles.map((role) => toMonthIndex(role.startDate)))
  : toMonthIndex(currentYearMonth);
const timelineEndMonth = rawOverviewRoles.length
  ? Math.max(...rawOverviewRoles.map((role) => toMonthIndex(role.endDate)))
  : timelineStartMonth;
const timelineMonthCount = Math.max(timelineEndMonth - timelineStartMonth + 1, 1);
const timelineStartYear = Math.floor(timelineStartMonth / 12);
const timelineEndYear = Math.floor(timelineEndMonth / 12);
const yearCount = timelineEndYear - timelineStartYear + 1;
const yearLabelStep = Math.max(1, Math.ceil(yearCount / 4));

const overviewRoles = rawOverviewRoles.map((role, index) => {
  const startOffset = toMonthIndex(role.startDate) - timelineStartMonth;
  const endOffset = toMonthIndex(role.endDate) - timelineStartMonth;

  return {
    ...role,
    index,
    startOffset,
    endOffset,
    left: (startOffset / timelineMonthCount) * 100,
    width: ((endOffset - startOffset + 1) / timelineMonthCount) * 100,
    markerPosition: ((startOffset + 0.5) / timelineMonthCount) * 100,
    stageNumber: String(index + 1).padStart(2, '0'),
  };
});

const yearMarkers = Array.from({ length: yearCount }, (_, index) => {
  const year = timelineStartYear + index;
  const markerMonth = Math.max(year * 12, timelineStartMonth);
  const offset = markerMonth - timelineStartMonth;

  return {
    year,
    position: ((offset + 0.5) / timelineMonthCount) * 100,
    showLabel: index === 0 || index === yearCount - 1 || index % yearLabelStep === 0,
  };
});

const timelineMonths = Array.from({ length: timelineMonthCount }, (_, index) => {
  const absoluteMonth = timelineStartMonth + index;
  const year = Math.floor(absoluteMonth / 12);
  const month = (absoluteMonth % 12) + 1;
  const stage = overviewRoles.find((role) => role.startOffset === index);

  return {
    index,
    year,
    month,
    label: monthLabels[lang][month - 1],
    stageNumber: stage?.stageNumber,
    hasExperience: overviewRoles.some((role) => index >= role.startOffset && index <= role.endOffset),
  };
});

const overviewInitialIndex = Math.max(overviewRoles.length - 1, 0);
---

<section class="experience" id="experience" aria-labelledby="experience-title" data-experience-section>
  <Container>
    <SectionHeading
      index="02"
      eyebrow={copy[lang].eyebrow}
      title={copy[lang].title}
      description={copy[lang].description}
      headingId="experience-title"
    >
      <div
        slot="aside"
        class="career-map"
        data-career-map
        data-timeline-start={rawOverviewRoles[0]?.startDate ?? currentYearMonth}
        data-timeline-months={timelineMonthCount}
        aria-label={copy[lang].timeline}
      >
        <div class="career-map__header">
          <span>{copy[lang].timeline}</span>
          <span>{copy[lang].explore}</span>
        </div>

        <div class="career-map__axis">
          <div class="career-map__plot" data-career-axis>
            <div class="career-map__years" aria-hidden="true">
              {yearMarkers.map((marker) => (
                <span
                  class="career-map__year"
                  style={`--year-position: ${marker.position}%`}
                  hidden={!marker.showLabel}
                >
                  {marker.year}
                </span>
              ))}
            </div>

            <span class="career-map__baseline" aria-hidden="true"></span>

            {yearMarkers.map((marker) => (
              <span
                class="career-map__year-tick"
                style={`--year-position: ${marker.position}%`}
                aria-hidden="true"
              ></span>
            ))}

            {overviewRoles.map((role, index) => (
              <span
                class:list={['career-map__segment', { 'is-active': index === overviewInitialIndex }]}
                style={`--segment-left: ${role.left}%; --segment-width: ${role.width}%`}
                data-overview-role={role.key}
                data-start-index={role.startOffset}
                data-end-index={role.endOffset}
                aria-hidden="true"
              ></span>
            ))}

            {overviewRoles.map((role, index) => (
              <button
                class:list={['career-map__stage-marker', { 'is-active': index === overviewInitialIndex }]}
                type="button"
                style={`--stage-position: ${role.markerPosition}%`}
                data-stage-marker={role.key}
                aria-label={`${role.stageNumber}. ${role.role}, ${role.period}`}
                title={`${role.stageNumber} · ${role.role}`}
              >
                <span>{role.stageNumber}</span>
              </button>
            ))}

            <span class="career-map__cursor" data-career-cursor hidden aria-hidden="true"></span>
          </div>

          <div class="career-map__lens" data-career-lens hidden aria-hidden="true">
            <span class="career-map__lens-date" data-career-month></span>
            <div class="career-map__lens-window" data-career-lens-window>
              <div class="career-map__lens-track" data-career-month-track>
                {timelineMonths.map((month) => (
                  <span
                    class:list={[
                      'career-map__lens-month',
                      { 'has-experience': month.hasExperience },
                    ]}
                    data-lens-month={month.index}
                  >
                    <span class="career-map__lens-stage">{month.stageNumber ?? ''}</span>
                    <span class="career-map__lens-label">{month.label}</span>
                    <span class="career-map__lens-mark"></span>
                  </span>
                ))}
              </div>
              <span class="career-map__lens-center"></span>
            </div>
          </div>
        </div>
      </div>
    </SectionHeading>

    <div class="experience__companies">
      {experienceCompanies.map((company) => {
        const initialIndex = company.roles.length - 1;

        return (
          <article class="experience-company" data-experience-group>
            <header class="experience-company__header">
              <div class="experience-company__identity">
                <h3>{company.company[lang]}</h3>
                <p class="experience-company__location">{company.location[lang]}</p>
              </div>
              <p class="experience-company__period">{company.period[lang]}</p>
            </header>

            <div class="experience-company__workspace">
              <div
                class="experience-track"
                role="tablist"
                aria-label={`${copy[lang].stages} ${company.company[lang]}`}
              >
                <span class="experience-track__rail" aria-hidden="true">
                  <span class="experience-track__progress" data-track-progress></span>
                </span>

                {company.roles.map((role, index) => {
                  const tabId = `${company.id}-${role.id}-tab`;
                  const panelId = `${company.id}-${role.id}-panel`;
                  const isInitial = index === initialIndex;

                  return (
                    <button
                      class:list={['experience-stage', { 'is-active': isInitial }]}
                      type="button"
                      role="tab"
                      id={tabId}
                      aria-selected={isInitial ? 'true' : 'false'}
                      aria-controls={panelId}
                      tabindex={isInitial ? 0 : -1}
                      data-stage-tab
                      data-stage-index={index}
                      data-role-key={`${company.id}-${role.id}`}
                    >
                      <span class="experience-stage__index" aria-hidden="true">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span class="experience-stage__body">
                        <span class="experience-stage__period">{role.period[lang]}</span>
                        <span class="experience-stage__role">{role.role[lang]}</span>
                      </span>
                      <span class="experience-stage__signal" aria-hidden="true"></span>
                    </button>
                  );
                })}
              </div>

              <div class="experience-details" data-detail-host>
                {company.roles.map((role, index) => {
                  const tabId = `${company.id}-${role.id}-tab`;
                  const panelId = `${company.id}-${role.id}-panel`;
                  const isInitial = index === initialIndex;

                  return (
                    <div
                      class:list={['experience-detail', { 'is-active': isInitial }]}
                      role="tabpanel"
                      id={panelId}
                      aria-labelledby={tabId}
                      hidden={!isInitial}
                      data-stage-panel
                    >
                      <span class="experience-detail__watermark" aria-hidden="true">
                        {String(index + 1).padStart(2, '0')}
                      </span>

                      <div class="experience-detail__meta">
                        <span>{String(index + 1).padStart(2, '0')} / {String(company.roles.length).padStart(2, '0')}</span>
                        <span>{role.period[lang]}</span>
                      </div>

                      <h4>{role.role[lang]}</h4>
                      <p class="experience-detail__company">{company.company[lang]}</p>
                      <p class="experience-detail__description">{role.description[lang]}</p>

                      <ul class="experience-detail__highlights" aria-label={copy[lang].highlights}>
                        {role.highlights.map((highlight) => (
                          <li>{highlight[lang]}</li>
                        ))}
                      </ul>

                      {role.technologies.length > 0 && (
                        <ul class="experience-detail__technologies" aria-label={copy[lang].technologies}>
                          {role.technologies.map((technology) => (
                            <li>{technology}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </Container>
</section>

<style>
  .experience {
    --section-layout-columns: minmax(17rem, 0.42fr) minmax(0, 1fr);
    --section-layout-gap: clamp(var(--space-7), 7vw, var(--space-10));

    padding-block: clamp(var(--space-9), 12vw, var(--space-10));
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 4.5rem;
  }

  .career-map {
    display: grid;
    gap: var(--space-3);
    width: min(100%, 30rem);
    margin-left: auto;
  }

  .career-map__header {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .career-map__header span:last-child {
    opacity: 0.62;
  }

  .career-map__axis {
    position: relative;
    height: 5.25rem;
    isolation: isolate;
  }

  .career-map__plot {
    position: absolute;
    inset: 0 1.4rem;
    cursor: ew-resize;
  }

  .career-map__years {
    position: absolute;
    inset: 0 0 auto;
    height: 1rem;
    color: var(--color-text-muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    pointer-events: none;
  }

  .career-map__year {
    position: absolute;
    left: var(--year-position);
    transform: translateX(-50%);
  }

  .career-map__baseline {
    position: absolute;
    top: 2.25rem;
    right: 0;
    left: 0;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--color-border);
  }

  .career-map__year-tick {
    position: absolute;
    z-index: 2;
    top: 1.98rem;
    left: var(--year-position);
    width: 1px;
    height: 0.56rem;
    background: var(--color-text-muted);
    opacity: 0.42;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .career-map__segment {
    position: absolute;
    z-index: 1;
    top: 2.2rem;
    left: var(--segment-left);
    width: max(var(--segment-width), 0.35rem);
    height: 0.28rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    opacity: 0.44;
    pointer-events: none;
    transition: opacity var(--transition-fast);
  }

  .career-map__segment.is-active {
    opacity: 0.7;
  }

  .career-map__stage-marker {
    position: absolute;
    z-index: 3;
    top: 2.86rem;
    left: var(--stage-position);
    display: grid;
    min-width: 1.85rem;
    padding: 0.14rem 0.3rem 0.2rem;
    border: 0;
    background: transparent;
    color: var(--color-text-muted);
    font: inherit;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
    transform: translateX(-50%);
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .career-map__stage-marker::before {
    position: absolute;
    top: -0.62rem;
    left: 50%;
    width: 0.42rem;
    height: 0.42rem;
    border: 2px solid var(--color-background);
    border-radius: 50%;
    background: var(--color-text-muted);
    content: '';
    opacity: 0.68;
    transform: translate(-50%, -50%);
    transition:
      background-color var(--transition-fast),
      box-shadow var(--transition-fast),
      opacity var(--transition-fast),
      transform var(--transition-fast);
  }

  .career-map__stage-marker:is(:hover, :focus-visible),
  .career-map__stage-marker.is-active {
    color: var(--color-accent);
  }

  .career-map__stage-marker:is(:hover, :focus-visible)::before,
  .career-map__stage-marker.is-active::before {
    background: var(--color-accent);
    opacity: 1;
  }

  .career-map__stage-marker.is-active::before {
    box-shadow: 0 0 0 0.2rem rgb(75 180 230 / 0.14);
    transform: translate(-50%, -50%) scale(1.12);
  }

  .career-map__cursor {
    position: absolute;
    z-index: 4;
    top: 1.66rem;
    left: var(--cursor-position, 0%);
    width: 1px;
    height: 1.2rem;
    background: var(--color-accent);
    opacity: 0.85;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .career-map__cursor[hidden],
  .career-map__lens[hidden] {
    display: none;
  }

  .career-map__cursor::after {
    position: absolute;
    top: 0.62rem;
    left: 50%;
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--color-accent);
    content: '';
    transform: translate(-50%, -50%);
  }

  .career-map__lens {
    --lens-cell-width: 2.45rem;

    position: absolute;
    z-index: 6;
    top: -0.15rem;
    left: var(--lens-left, 0px);
    width: min(19rem, calc(100% - 0.8rem));
    padding: 0.55rem 0.7rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-elevated);
    box-shadow: var(--shadow-elevated);
    pointer-events: none;
    will-change: left;
  }

  .career-map__lens-date {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--color-heading);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .career-map__lens-window {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding-block: 0.15rem;
  }

  .career-map__lens-track {
    display: flex;
    width: max-content;
    transform: translate3d(var(--lens-track-x, 0px), 0, 0);
    will-change: transform;
  }

  .career-map__lens-month {
    position: relative;
    display: grid;
    flex: 0 0 var(--lens-cell-width);
    grid-template-rows: 0.72rem auto 0.65rem;
    gap: 0.16rem;
    justify-items: center;
    color: var(--color-text-muted);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .career-map__lens-stage {
    color: var(--color-accent);
    font-size: 0.5rem;
    font-weight: 800;
    line-height: 1;
  }

  .career-map__lens-label {
    line-height: 1;
  }

  .career-map__lens-mark {
    width: 68%;
    height: 1px;
    margin-top: 0.14rem;
    background: var(--color-border);
  }

  .career-map__lens-month.has-experience .career-map__lens-mark {
    height: 2px;
    background: var(--color-accent);
    opacity: 0.5;
  }

  .career-map__lens-center {
    position: absolute;
    top: 0.1rem;
    bottom: 0.1rem;
    left: var(--lens-focus-x, 50%);
    width: 1px;
    background: var(--color-accent);
    opacity: 0.7;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .career-map__lens-center::after {
    position: absolute;
    bottom: 0.05rem;
    left: 50%;
    width: 0.36rem;
    height: 0.36rem;
    border-radius: 50%;
    background: var(--color-accent);
    content: '';
    transform: translate(-50%, 50%);
  }

  .experience__companies {
    display: grid;
    gap: var(--space-10);
    margin-top: clamp(var(--space-8), 7vw, var(--space-9));
  }

  .experience-company + .experience-company {
    padding-top: var(--space-9);
    border-top: 1px solid var(--color-border);
  }

  .experience-company__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: clamp(var(--space-7), 5vw, var(--space-8));
  }

  .experience-company__identity {
    min-width: 0;
  }

  .experience-company h3 {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    letter-spacing: -0.035em;
  }

  .experience-company__location {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }

  .experience-company__period {
    flex: none;
    padding-bottom: 0.2rem;
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .experience-company__workspace {
    display: grid;
    gap: var(--space-8);
  }

  .experience-track {
    position: relative;
    display: grid;
    align-content: start;
  }

  .experience-track__rail {
    position: absolute;
    top: 2.15rem;
    bottom: 2.15rem;
    left: 1.34rem;
    width: 1px;
    overflow: hidden;
    background: var(--color-border);
    pointer-events: none;
  }

  .experience-track__progress {
    display: block;
    width: 100%;
    height: var(--track-progress, 0%);
    background: var(--color-accent);
    transition: height 280ms ease;
  }

  .experience-stage {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) 1rem;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    padding: var(--space-4) 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .experience-stage__index {
    position: relative;
    z-index: 1;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-background);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .experience-stage__body {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .experience-stage__period {
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .experience-stage__role {
    color: var(--color-text-muted);
    font-weight: 700;
    line-height: 1.35;
    transition: color var(--transition-fast);
  }

  .experience-stage__signal {
    width: 0.7rem;
    height: 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .experience-stage:is(:hover, :focus-visible) .experience-stage__role,
  .experience-stage.is-active .experience-stage__role {
    color: var(--color-heading);
  }

  .experience-stage.is-active .experience-stage__index {
    border-color: var(--color-accent);
    background: var(--color-surface-elevated);
    color: var(--color-accent);
  }

  .experience-stage.is-active .experience-stage__signal {
    border-color: var(--color-accent);
    background: var(--color-accent);
    transform: scale(1.15);
  }

  .experience-details {
    min-width: 0;
  }

  .experience-detail {
    position: relative;
    min-height: 24rem;
    overflow: hidden;
    padding-top: var(--space-3);
  }

  .experience-detail[hidden] {
    display: none;
  }

  .experience-detail.is-entering {
    animation: experience-detail-in 220ms ease both;
  }

  .experience-detail__watermark {
    position: absolute;
    z-index: 0;
    top: -1.5rem;
    right: 0;
    color: var(--color-border);
    font-size: clamp(5rem, 12vw, 9rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.08em;
    opacity: 0.5;
    pointer-events: none;
    user-select: none;
  }

  .experience-detail > :not(.experience-detail__watermark) {
    position: relative;
    z-index: 1;
  }

  .experience-detail__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: 46rem;
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .experience-detail h4 {
    max-width: 24ch;
    margin-top: var(--space-5);
    font-size: clamp(1.8rem, 4vw, 3rem);
    letter-spacing: -0.04em;
  }

  .experience-detail__company {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-weight: 700;
  }

  .experience-detail__description {
    max-width: 46rem;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .experience-detail__highlights {
    display: grid;
    gap: var(--space-3);
    max-width: 46rem;
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .experience-detail__highlights li {
    position: relative;
    padding-left: var(--space-5);
  }

  .experience-detail__highlights li::before {
    position: absolute;
    top: 0.7em;
    left: 0;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--color-accent);
    content: '';
  }

  .experience-detail__technologies {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .experience-detail__technologies li {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 600;
  }

  @keyframes experience-detail-in {
    from {
      opacity: 0;
      transform: translateY(0.4rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 68rem) {
    .experience-company__workspace {
      grid-template-columns: var(--section-layout-columns);
      column-gap: var(--section-layout-gap);
    }

    .experience-track {
      padding-right: var(--space-4);
    }

    .experience-details {
      position: sticky;
      top: 7rem;
      align-self: start;
    }
  }

  @media (max-width: 47.99rem) {
    .career-map {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .experience__companies {
      margin-top: var(--space-8);
    }

    .experience-company__header {
      align-items: start;
      flex-direction: column;
      margin-bottom: var(--space-7);
    }

    .experience-company__period {
      order: -1;
      padding-bottom: 0;
    }

    .experience-stage {
      grid-template-columns: 2.75rem minmax(0, 1fr);
    }

    .experience-stage__signal {
      display: none;
    }

    .experience-detail {
      min-height: 0;
      padding-top: var(--space-5);
      border-top: 1px solid var(--color-border);
    }

    .experience-detail__watermark {
      top: 0.75rem;
      font-size: clamp(4rem, 22vw, 6rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .career-map__segment,
    .career-map__stage-marker,
    .career-map__stage-marker::before,
    .experience-track__progress,
    .experience-stage__index,
    .experience-stage__role,
    .experience-stage__signal {
      transition: none;
    }

    .experience-detail.is-entering {
      animation: none;
    }
  }
</style>

<script>
  const careerMap = document.querySelector<HTMLElement>('[data-career-map]');
  const careerAxisContainer = careerMap?.querySelector<HTMLElement>('.career-map__axis');
  const careerAxis = careerMap?.querySelector<HTMLElement>('[data-career-axis]');
  const careerCursor = careerMap?.querySelector<HTMLElement>('[data-career-cursor]');
  const careerLens = careerMap?.querySelector<HTMLElement>('[data-career-lens]');
  const careerMonth = careerMap?.querySelector<HTMLElement>('[data-career-month]');
  const careerLensWindow = careerMap?.querySelector<HTMLElement>('[data-career-lens-window]');
  const careerMonthTrack = careerMap?.querySelector<HTMLElement>('[data-career-month-track]');
  const overviewSegments = careerMap
    ? Array.from(careerMap.querySelectorAll<HTMLElement>('[data-overview-role]'))
    : [];
  const stageMarkers = careerMap
    ? Array.from(careerMap.querySelectorAll<HTMLButtonElement>('[data-stage-marker]'))
    : [];
  const roleActivators = new Map<string, () => void>();

  const updateOverview = (roleKey: string | undefined) => {
    if (!roleKey) return;

    overviewSegments.forEach((segment) => {
      segment.classList.toggle('is-active', segment.dataset.overviewRole === roleKey);
    });

    stageMarkers.forEach((marker) => {
      marker.classList.toggle('is-active', marker.dataset.stageMarker === roleKey);
    });
  };

  const groups = document.querySelectorAll<HTMLElement>('[data-experience-group]');

  groups.forEach((group) => {
    const tabs = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-stage-tab]'));
    const panels = Array.from(group.querySelectorAll<HTMLElement>('[data-stage-panel]'));
    const progress = group.querySelector<HTMLElement>('[data-track-progress]');

    const activate = (nextIndex: number, moveFocus = false) => {
      const index = Math.max(0, Math.min(nextIndex, tabs.length - 1));

      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });

      panels.forEach((panel, panelIndex) => {
        const active = panelIndex === index;
        panel.hidden = !active;
        panel.classList.toggle('is-active', active);

        if (active) {
          panel.classList.remove('is-entering');
          requestAnimationFrame(() => panel.classList.add('is-entering'));
        }
      });

      if (progress) {
        const percentage = tabs.length <= 1 ? 100 : (index / (tabs.length - 1)) * 100;
        progress.style.setProperty('--track-progress', `${percentage}%`);
      }

      updateOverview(tabs[index]?.dataset.roleKey);

      if (moveFocus) tabs[index]?.focus();
    };

    tabs.forEach((tab, index) => {
      const roleKey = tab.dataset.roleKey;
      if (roleKey) roleActivators.set(roleKey, () => activate(index));

      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', (event) => {
        let nextIndex: number | null = null;

        if (event.key === 'ArrowDown' || event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabs.length - 1;

        if (nextIndex !== null) {
          event.preventDefault();
          activate(nextIndex, true);
        }
      });
    });

    activate(tabs.length - 1);
  });

  stageMarkers.forEach((marker) => {
    marker.addEventListener('click', (event) => {
      event.stopPropagation();
      const roleKey = marker.dataset.stageMarker;
      if (roleKey) roleActivators.get(roleKey)?.();
    });
  });

  if (
    careerMap &&
    careerAxisContainer &&
    careerAxis &&
    careerCursor &&
    careerLens &&
    careerMonth &&
    careerLensWindow &&
    careerMonthTrack
  ) {
    const startDate = careerMap.dataset.timelineStart;
    const monthCount = Number(careerMap.dataset.timelineMonths ?? 0);

    if (startDate && monthCount > 0) {
      const [startYear, startMonth] = startDate.split('-').map(Number);
      const startAbsoluteMonth = startYear * 12 + startMonth - 1;
      const locale = document.documentElement.lang || 'es';
      const dateFormatter = new Intl.DateTimeFormat(locale, {
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      });
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let hoveredRoleKey: string | undefined;
      let targetRatio = 0;
      let renderedRatio = 0;
      let targetLensLeft = 0;
      let renderedLensLeft = 0;
      let frameId: number | null = null;

      const getRoleForMonth = (monthIndex: number) =>
        overviewSegments.find((segment) => {
          const start = Number(segment.dataset.startIndex);
          const end = Number(segment.dataset.endIndex);
          return monthIndex >= start && monthIndex <= end;
        });

      const render = () => {
        const smoothing = reducedMotion ? 1 : 0.16;
        renderedRatio += (targetRatio - renderedRatio) * smoothing;
        renderedLensLeft += (targetLensLeft - renderedLensLeft) * smoothing;

        const monthFloat = Math.max(0, Math.min(renderedRatio * (monthCount - 1), monthCount - 1));
        const monthIndex = Math.max(0, Math.min(Math.round(monthFloat), monthCount - 1));
        const absoluteMonth = startAbsoluteMonth + monthIndex;
        const year = Math.floor(absoluteMonth / 12);
        const month = (absoluteMonth % 12) + 1;
        const date = new Date(Date.UTC(year, month - 1, 1));
        const role = getRoleForMonth(monthIndex);
        const firstMonth = careerMonthTrack.querySelector<HTMLElement>('[data-lens-month]');
        const cellWidth = firstMonth?.getBoundingClientRect().width ?? 39.2;
        const windowWidth = careerLensWindow.clientWidth;
        const trackWidth = monthCount * cellWidth;
        const idealTrackOffset = windowWidth / 2 - (monthFloat + 0.5) * cellWidth;
        const minTrackOffset = Math.min(0, windowWidth - trackWidth);
        const trackOffset = Math.max(minTrackOffset, Math.min(idealTrackOffset, 0));
        const focusX = (monthFloat + 0.5) * cellWidth + trackOffset;

        careerCursor.style.setProperty('--cursor-position', `${renderedRatio * 100}%`);
        careerLens.style.setProperty('--lens-left', `${renderedLensLeft}px`);
        careerMonthTrack.style.setProperty('--lens-track-x', `${trackOffset}px`);
        careerLensWindow.style.setProperty('--lens-focus-x', `${focusX}px`);
        careerMonth.textContent = dateFormatter.format(date).replace('.', '').toUpperCase();
        hoveredRoleKey = role?.dataset.overviewRole;

        const settled =
          Math.abs(targetRatio - renderedRatio) < 0.0005 &&
          Math.abs(targetLensLeft - renderedLensLeft) < 0.15;

        if (!settled) {
          frameId = requestAnimationFrame(render);
        } else {
          frameId = null;
        }
      };

      const requestRender = () => {
        if (frameId === null) frameId = requestAnimationFrame(render);
      };

      const updateTarget = (event: PointerEvent) => {
        const plotBounds = careerAxis.getBoundingClientRect();
        const axisBounds = careerAxisContainer.getBoundingClientRect();
        targetRatio = Math.max(0, Math.min((event.clientX - plotBounds.left) / plotBounds.width, 1));

        careerCursor.hidden = false;
        careerLens.hidden = false;

        const lensWidth = careerLens.offsetWidth;
        const cursorX = plotBounds.left - axisBounds.left + targetRatio * plotBounds.width;
        const lensMargin = 6;
        targetLensLeft = Math.max(
          lensMargin,
          Math.min(cursorX - lensWidth / 2, axisBounds.width - lensWidth - lensMargin),
        );

        if (frameId === null) {
          renderedRatio = targetRatio;
          renderedLensLeft = targetLensLeft;
          render();
        } else {
          requestRender();
        }
      };

      careerAxis.addEventListener('pointerenter', updateTarget);
      careerAxis.addEventListener('pointermove', updateTarget);
      careerAxis.addEventListener('pointerleave', () => {
        careerCursor.hidden = true;
        careerLens.hidden = true;
        hoveredRoleKey = undefined;
      });
      careerAxis.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('[data-stage-marker]')) return;
        if (hoveredRoleKey) roleActivators.get(hoveredRoleKey)?.();
      });
    }
  }
</script>
