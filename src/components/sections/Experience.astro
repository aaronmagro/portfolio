---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { experienceCompanies } from '../../data/experience';
import { siteConfig } from '../../config/site';

type SupportedLocale = (typeof siteConfig.locales)[number];

interface Props {
  lang?: SupportedLocale;
}

const { lang = siteConfig.defaultLocale } = Astro.props;

const copy = {
  es: {
    eyebrow: 'Trayectoria profesional',
    title: 'Experiencia',
    description:
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer vitae lorem at sapien tincidunt luctus eget sed arcu.',
    stages: 'Etapas dentro de',
    highlights: 'Aspectos destacados',
    technologies: 'Tecnologías',
    timeAxis: 'Tiempo',
    stageAxis: 'Etapas',
    timeline: 'Cronología profesional',
  },
  en: {
    eyebrow: 'Professional background',
    title: 'Experience',
    description:
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer vitae lorem at sapien tincidunt luctus eget sed arcu.',
    stages: 'Roles at',
    highlights: 'Highlights',
    technologies: 'Technologies',
    timeAxis: 'Time',
    stageAxis: 'Stages',
    timeline: 'Professional timeline',
  },
} as const;

const toMonthIndex = (value: string) => {
  const [year, month] = value.split('-').map(Number);
  return year * 12 + month - 1;
};

const currentDate = new Date();
const currentYearMonth = `${currentDate.getFullYear()}-${String(currentDate.getMonth() + 1).padStart(2, '0')}`;

const rawOverviewRoles = experienceCompanies.flatMap((company) =>
  company.roles.map((role) => ({
    key: `${company.id}-${role.id}`,
    role: role.role[lang],
    period: role.period[lang],
    startDate: role.startDate,
    endDate: role.endDate ?? currentYearMonth,
  })),
);

const timelineStartMonth = rawOverviewRoles.length
  ? Math.min(...rawOverviewRoles.map((role) => toMonthIndex(role.startDate)))
  : toMonthIndex(currentYearMonth);
const timelineEndMonth = rawOverviewRoles.length
  ? Math.max(...rawOverviewRoles.map((role) => toMonthIndex(role.endDate)))
  : timelineStartMonth;
const timelineMonthCount = Math.max(timelineEndMonth - timelineStartMonth + 1, 1);

const timelineMonths = Array.from({ length: timelineMonthCount }, (_, index) => {
  const absoluteMonth = timelineStartMonth + index;
  const year = Math.floor(absoluteMonth / 12);
  const month = (absoluteMonth % 12) + 1;

  return {
    index,
    year,
    month,
    position: ((index + 0.5) / timelineMonthCount) * 100,
    isYearBoundary: index === 0 || month === 1,
  };
});

const yearMarkers = timelineMonths.filter((month) => month.isYearBoundary);

const overviewRoles = rawOverviewRoles.map((role, index) => {
  const startOffset = toMonthIndex(role.startDate) - timelineStartMonth;
  const endOffset = toMonthIndex(role.endDate) - timelineStartMonth;

  return {
    ...role,
    index,
    startOffset,
    endOffset,
    left: (startOffset / timelineMonthCount) * 100,
    width: ((endOffset - startOffset + 1) / timelineMonthCount) * 100,
  };
});

const overviewInitialIndex = Math.max(overviewRoles.length - 1, 0);
---

<section class="experience" id="experience" aria-labelledby="experience-title" data-experience-section>
  <Container>
    <SectionHeading
      index="02"
      eyebrow={copy[lang].eyebrow}
      title={copy[lang].title}
      description={copy[lang].description}
      headingId="experience-title"
    >
      <div
        slot="aside"
        class="experience-overview"
        data-experience-overview
        data-timeline-start={rawOverviewRoles[0]?.startDate ?? currentYearMonth}
        data-timeline-months={timelineMonthCount}
        aria-label={copy[lang].timeline}
      >
        <span class="experience-overview__label">{copy[lang].timeAxis}</span>
        <div class="experience-overview__time">
          <div class="experience-overview__years" aria-hidden="true">
            {yearMarkers.map((marker, index) => (
              <span
                class:list={['experience-overview__year', { 'is-first': index === 0 }]}
                style={`--marker-position: ${marker.position}%`}
              >
                {marker.year}
              </span>
            ))}
          </div>

          <div class="experience-overview__axis" data-career-axis aria-hidden="true">
            <span class="experience-overview__baseline"></span>

            {timelineMonths.map((month) => (
              <span
                class:list={['experience-overview__tick', { 'is-year': month.month === 1 }]}
                style={`--tick-position: ${month.position}%`}
              ></span>
            ))}

            <span class="experience-overview__cursor" data-career-cursor hidden>
              <span class="experience-overview__cursor-label" data-career-month></span>
            </span>
          </div>
        </div>

        <span class="experience-overview__label">{copy[lang].stageAxis}</span>
        <div class="experience-overview__stages">
          {overviewRoles.map((role, index) => (
            <button
              class:list={[
                'experience-overview__stage',
                { 'is-active': index === overviewInitialIndex },
              ]}
              type="button"
              style={`--stage-left: ${role.left}%; --stage-width: ${role.width}%`}
              data-overview-role={role.key}
              data-start-index={role.startOffset}
              data-end-index={role.endOffset}
              aria-label={`${role.role}, ${role.period}`}
              title={`${role.role} · ${role.period}`}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
            </button>
          ))}
        </div>
      </div>
    </SectionHeading>

    <div class="experience__companies">
      {experienceCompanies.map((company) => {
        const initialIndex = company.roles.length - 1;

        return (
          <article class="experience-company" data-experience-group>
            <header class="experience-company__header">
              <div class="experience-company__identity">
                <h3>{company.company[lang]}</h3>
                <p class="experience-company__location">{company.location[lang]}</p>
              </div>
              <p class="experience-company__period">{company.period[lang]}</p>
            </header>

            <div class="experience-company__workspace">
              <div
                class="experience-track"
                role="tablist"
                aria-label={`${copy[lang].stages} ${company.company[lang]}`}
              >
                <span class="experience-track__rail" aria-hidden="true">
                  <span class="experience-track__progress" data-track-progress></span>
                </span>

                {company.roles.map((role, index) => {
                  const tabId = `${company.id}-${role.id}-tab`;
                  const panelId = `${company.id}-${role.id}-panel`;
                  const isInitial = index === initialIndex;

                  return (
                    <button
                      class:list={['experience-stage', { 'is-active': isInitial }]}
                      type="button"
                      role="tab"
                      id={tabId}
                      aria-selected={isInitial ? 'true' : 'false'}
                      aria-controls={panelId}
                      tabindex={isInitial ? 0 : -1}
                      data-stage-tab
                      data-stage-index={index}
                      data-role-key={`${company.id}-${role.id}`}
                    >
                      <span class="experience-stage__index" aria-hidden="true">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span class="experience-stage__body">
                        <span class="experience-stage__period">{role.period[lang]}</span>
                        <span class="experience-stage__role">{role.role[lang]}</span>
                      </span>
                      <span class="experience-stage__signal" aria-hidden="true"></span>
                    </button>
                  );
                })}
              </div>

              <div class="experience-details" data-detail-host>
                {company.roles.map((role, index) => {
                  const tabId = `${company.id}-${role.id}-tab`;
                  const panelId = `${company.id}-${role.id}-panel`;
                  const isInitial = index === initialIndex;

                  return (
                    <div
                      class:list={['experience-detail', { 'is-active': isInitial }]}
                      role="tabpanel"
                      id={panelId}
                      aria-labelledby={tabId}
                      hidden={!isInitial}
                      data-stage-panel
                    >
                      <span class="experience-detail__watermark" aria-hidden="true">
                        {String(index + 1).padStart(2, '0')}
                      </span>

                      <div class="experience-detail__meta">
                        <span>{String(index + 1).padStart(2, '0')} / {String(company.roles.length).padStart(2, '0')}</span>
                        <span>{role.period[lang]}</span>
                      </div>

                      <h4>{role.role[lang]}</h4>
                      <p class="experience-detail__company">{company.company[lang]}</p>
                      <p class="experience-detail__description">{role.description[lang]}</p>

                      <ul class="experience-detail__highlights" aria-label={copy[lang].highlights}>
                        {role.highlights.map((highlight) => (
                          <li>{highlight[lang]}</li>
                        ))}
                      </ul>

                      {role.technologies.length > 0 && (
                        <ul class="experience-detail__technologies" aria-label={copy[lang].technologies}>
                          {role.technologies.map((technology) => (
                            <li>{technology}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </Container>
</section>

<style>
  .experience {
    --section-layout-columns: minmax(17rem, 0.42fr) minmax(0, 1fr);
    --section-layout-gap: clamp(var(--space-7), 7vw, var(--space-10));

    padding-block: clamp(var(--space-9), 12vw, var(--space-10));
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 4.5rem;
  }

  .experience-overview {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3) var(--space-4);
    width: min(100%, 30rem);
    margin-left: auto;
  }

  .experience-overview__label {
    align-self: center;
    color: var(--color-text-muted);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .experience-overview__time {
    position: relative;
    min-width: 0;
    padding-top: 1.15rem;
  }

  .experience-overview__years {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 1rem;
    color: var(--color-text-muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    pointer-events: none;
  }

  .experience-overview__year {
    position: absolute;
    left: var(--marker-position);
    transform: translateX(-50%);
  }

  .experience-overview__year.is-first {
    transform: translateX(-35%);
  }

  .experience-overview__axis {
    position: relative;
    height: 2.25rem;
    cursor: crosshair;
  }

  .experience-overview__baseline {
    position: absolute;
    top: 0.62rem;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--color-border);
  }

  .experience-overview__tick {
    position: absolute;
    top: 0.39rem;
    left: var(--tick-position);
    width: 1px;
    height: 0.48rem;
    background: var(--color-border);
    transform: translateX(-50%);
  }

  .experience-overview__tick.is-year {
    top: 0.25rem;
    height: 0.76rem;
    background: var(--color-text-muted);
    opacity: 0.7;
  }

  .experience-overview__cursor {
    position: absolute;
    z-index: 3;
    top: 0.05rem;
    left: var(--cursor-position, 0%);
    width: 1px;
    height: 1.15rem;
    background: var(--color-accent);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .experience-overview__cursor[hidden] {
    display: none;
  }

  .experience-overview__cursor::after {
    position: absolute;
    top: 0.46rem;
    left: 50%;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--color-accent);
    content: '';
    transform: translate(-50%, -50%);
  }

  .experience-overview__cursor-label {
    position: absolute;
    top: 1.3rem;
    left: 50%;
    padding: 0.16rem 0.38rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface-elevated);
    color: var(--color-text);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.25;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .experience-overview__stages {
    position: relative;
    min-width: 0;
    height: 2rem;
  }

  .experience-overview__stage {
    position: absolute;
    top: 0.12rem;
    left: var(--stage-left);
    width: max(var(--stage-width), 2rem);
    height: 1.65rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-background-subtle);
    color: var(--color-text-muted);
    font: inherit;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .experience-overview__stage:is(:hover, :focus-visible),
  .experience-overview__stage.is-previewed {
    border-color: var(--color-text-muted);
    color: var(--color-heading);
    transform: translateY(-0.08rem);
  }

  .experience-overview__stage.is-active {
    border-color: var(--color-accent);
    background: var(--color-surface-elevated);
    color: var(--color-accent);
  }

  .experience__companies {
    display: grid;
    gap: var(--space-10);
    margin-top: clamp(var(--space-8), 7vw, var(--space-9));
  }

  .experience-company + .experience-company {
    padding-top: var(--space-9);
    border-top: 1px solid var(--color-border);
  }

  .experience-company__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: clamp(var(--space-7), 5vw, var(--space-8));
  }

  .experience-company__identity {
    min-width: 0;
  }

  .experience-company h3 {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    letter-spacing: -0.035em;
  }

  .experience-company__location {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }

  .experience-company__period {
    flex: none;
    padding-bottom: 0.2rem;
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .experience-company__workspace {
    display: grid;
    gap: var(--space-8);
  }

  .experience-track {
    position: relative;
    display: grid;
    align-content: start;
  }

  .experience-track__rail {
    position: absolute;
    top: 2.15rem;
    bottom: 2.15rem;
    left: 1.34rem;
    width: 1px;
    overflow: hidden;
    background: var(--color-border);
    pointer-events: none;
  }

  .experience-track__progress {
    display: block;
    width: 100%;
    height: var(--track-progress, 0%);
    background: var(--color-accent);
    transition: height 280ms ease;
  }

  .experience-stage {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) 1rem;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    padding: var(--space-4) 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .experience-stage__index {
    position: relative;
    z-index: 1;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-background);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .experience-stage__body {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .experience-stage__period {
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .experience-stage__role {
    color: var(--color-text-muted);
    font-weight: 700;
    line-height: 1.35;
    transition: color var(--transition-fast);
  }

  .experience-stage__signal {
    width: 0.7rem;
    height: 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .experience-stage:is(:hover, :focus-visible) .experience-stage__role,
  .experience-stage.is-active .experience-stage__role {
    color: var(--color-heading);
  }

  .experience-stage.is-active .experience-stage__index {
    border-color: var(--color-accent);
    background: var(--color-surface-elevated);
    color: var(--color-accent);
  }

  .experience-stage.is-active .experience-stage__signal {
    border-color: var(--color-accent);
    background: var(--color-accent);
    transform: scale(1.15);
  }

  .experience-details {
    min-width: 0;
  }

  .experience-detail {
    position: relative;
    min-height: 24rem;
    overflow: hidden;
    padding-top: var(--space-3);
  }

  .experience-detail[hidden] {
    display: none;
  }

  .experience-detail.is-entering {
    animation: experience-detail-in 220ms ease both;
  }

  .experience-detail__watermark {
    position: absolute;
    z-index: 0;
    top: -1.5rem;
    right: 0;
    color: var(--color-border);
    font-size: clamp(5rem, 12vw, 9rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.08em;
    opacity: 0.5;
    pointer-events: none;
    user-select: none;
  }

  .experience-detail > :not(.experience-detail__watermark) {
    position: relative;
    z-index: 1;
  }

  .experience-detail__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: 46rem;
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .experience-detail h4 {
    max-width: 24ch;
    margin-top: var(--space-5);
    font-size: clamp(1.8rem, 4vw, 3rem);
    letter-spacing: -0.04em;
  }

  .experience-detail__company {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-weight: 700;
  }

  .experience-detail__description {
    max-width: 46rem;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .experience-detail__highlights {
    display: grid;
    gap: var(--space-3);
    max-width: 46rem;
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .experience-detail__highlights li {
    position: relative;
    padding-left: var(--space-5);
  }

  .experience-detail__highlights li::before {
    position: absolute;
    top: 0.7em;
    left: 0;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--color-accent);
    content: '';
  }

  .experience-detail__technologies {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .experience-detail__technologies li {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 600;
  }

  @keyframes experience-detail-in {
    from {
      opacity: 0;
      transform: translateY(0.4rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 68rem) {
    .experience-company__workspace {
      grid-template-columns: var(--section-layout-columns);
      column-gap: var(--section-layout-gap);
    }

    .experience-track {
      padding-right: var(--space-4);
    }

    .experience-details {
      position: sticky;
      top: 7rem;
      align-self: start;
    }
  }

  @media (max-width: 47.99rem) {
    .experience-overview {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .experience__companies {
      margin-top: var(--space-8);
    }

    .experience-company__header {
      align-items: start;
      flex-direction: column;
      margin-bottom: var(--space-7);
    }

    .experience-company__period {
      order: -1;
      padding-bottom: 0;
    }

    .experience-stage {
      grid-template-columns: 2.75rem minmax(0, 1fr);
    }

    .experience-stage__signal {
      display: none;
    }

    .experience-detail {
      min-height: 0;
      padding-top: var(--space-5);
      border-top: 1px solid var(--color-border);
    }

    .experience-detail__watermark {
      top: 0.75rem;
      font-size: clamp(4rem, 22vw, 6rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .experience-overview__stage,
    .experience-track__progress,
    .experience-stage__index,
    .experience-stage__role,
    .experience-stage__signal {
      transition: none;
    }

    .experience-detail.is-entering {
      animation: none;
    }
  }
</style>

<script>
  const overview = document.querySelector<HTMLElement>('[data-experience-overview]');
  const overviewStages = overview
    ? Array.from(overview.querySelectorAll<HTMLButtonElement>('[data-overview-role]'))
    : [];
  const careerAxis = overview?.querySelector<HTMLElement>('[data-career-axis]');
  const careerCursor = overview?.querySelector<HTMLElement>('[data-career-cursor]');
  const careerMonth = overview?.querySelector<HTMLElement>('[data-career-month]');
  const roleActivators = new Map<string, () => void>();

  const updateOverview = (roleKey: string | undefined) => {
    if (!roleKey) return;

    overviewStages.forEach((stage) => {
      stage.classList.toggle('is-active', stage.dataset.overviewRole === roleKey);
    });
  };

  const groups = document.querySelectorAll<HTMLElement>('[data-experience-group]');

  groups.forEach((group) => {
    const tabs = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-stage-tab]'));
    const panels = Array.from(group.querySelectorAll<HTMLElement>('[data-stage-panel]'));
    const progress = group.querySelector<HTMLElement>('[data-track-progress]');

    const activate = (nextIndex: number, moveFocus = false) => {
      const index = Math.max(0, Math.min(nextIndex, tabs.length - 1));

      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });

      panels.forEach((panel, panelIndex) => {
        const active = panelIndex === index;
        panel.hidden = !active;
        panel.classList.toggle('is-active', active);

        if (active) {
          panel.classList.remove('is-entering');
          requestAnimationFrame(() => panel.classList.add('is-entering'));
        }
      });

      if (progress) {
        const percentage = tabs.length <= 1 ? 100 : (index / (tabs.length - 1)) * 100;
        progress.style.setProperty('--track-progress', `${percentage}%`);
      }

      updateOverview(tabs[index]?.dataset.roleKey);

      if (moveFocus) tabs[index]?.focus();
    };

    tabs.forEach((tab, index) => {
      const roleKey = tab.dataset.roleKey;
      if (roleKey) roleActivators.set(roleKey, () => activate(index));

      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', (event) => {
        let nextIndex: number | null = null;

        if (event.key === 'ArrowDown' || event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabs.length - 1;

        if (nextIndex !== null) {
          event.preventDefault();
          activate(nextIndex, true);
        }
      });
    });

    activate(tabs.length - 1);
  });

  overviewStages.forEach((stage, index) => {
    const activateStage = () => {
      const roleKey = stage.dataset.overviewRole;
      if (roleKey) roleActivators.get(roleKey)?.();
    };

    stage.addEventListener('mouseenter', activateStage);
    stage.addEventListener('focus', activateStage);
    stage.addEventListener('click', activateStage);
    stage.addEventListener('keydown', (event) => {
      let nextIndex: number | null = null;

      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') nextIndex = (index + 1) % overviewStages.length;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') nextIndex = (index - 1 + overviewStages.length) % overviewStages.length;
      if (event.key === 'Home') nextIndex = 0;
      if (event.key === 'End') nextIndex = overviewStages.length - 1;

      if (nextIndex !== null) {
        event.preventDefault();
        overviewStages[nextIndex]?.focus();
      }
    });
  });

  if (overview && careerAxis && careerCursor && careerMonth) {
    const startDate = overview.dataset.timelineStart;
    const monthCount = Number(overview.dataset.timelineMonths ?? 0);

    if (startDate && monthCount > 0) {
      const [startYear, startMonth] = startDate.split('-').map(Number);
      const locale = document.documentElement.lang || 'es';
      const monthFormatter = new Intl.DateTimeFormat(locale, {
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      });

      let previewedStage: HTMLButtonElement | null = null;

      const clearPreview = () => {
        previewedStage?.classList.remove('is-previewed');
        previewedStage = null;
      };

      const updateCursor = (event: PointerEvent) => {
        const bounds = careerAxis.getBoundingClientRect();
        const ratio = Math.max(0, Math.min((event.clientX - bounds.left) / bounds.width, 0.999999));
        const monthIndex = Math.min(Math.floor(ratio * monthCount), monthCount - 1);
        const position = ((monthIndex + 0.5) / monthCount) * 100;
        const date = new Date(Date.UTC(startYear, startMonth - 1 + monthIndex, 1));

        careerCursor.hidden = false;
        careerCursor.style.setProperty('--cursor-position', `${position}%`);
        careerMonth.textContent = monthFormatter.format(date).replace('.', '').toUpperCase();

        const matchingStage = overviewStages.find((stage) => {
          const start = Number(stage.dataset.startIndex);
          const end = Number(stage.dataset.endIndex);
          return monthIndex >= start && monthIndex <= end;
        }) ?? null;

        if (matchingStage !== previewedStage) {
          clearPreview();
          previewedStage = matchingStage;
          previewedStage?.classList.add('is-previewed');
        }
      };

      careerAxis.addEventListener('pointermove', updateCursor);
      careerAxis.addEventListener('pointerleave', () => {
        careerCursor.hidden = true;
        clearPreview();
      });
      careerAxis.addEventListener('click', () => {
        const roleKey = previewedStage?.dataset.overviewRole;
        if (roleKey) roleActivators.get(roleKey)?.();
      });
    }
  }
</script>
