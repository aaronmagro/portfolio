---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../ui/Container.astro';
import ButtonLink from '../ui/ButtonLink.astro';
import { siteConfig, type SupportedLocale } from '../../config/site';
import { routes } from '../../utils/i18n';

// Served for missing pages: /404.html for the Spanish site and /en/404.html for anything under /en/
// (static hosts such as Cloudflare Pages use the nearest 404.html up the path).
interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;

const copy = {
  es: {
    title: `Página no encontrada | ${siteConfig.name}`,
    heading: 'Esta página no existe',
    text: 'Puede que el enlace esté mal o que la página se haya movido.',
    home: 'Volver al inicio',
    projects: 'Ver proyectos',
  },
  en: {
    title: `Page not found | ${siteConfig.name}`,
    heading: 'This page does not exist',
    text: 'The link may be wrong or the page may have moved.',
    home: 'Back to home',
    projects: 'See projects',
  },
} as const;

const text = copy[lang];
---

<BaseLayout lang={lang} title={text.title}>
  <main id="main-content" class="not-found">
    <Container>
      <p class="not-found__code">404</p>
      <h1>{text.heading}</h1>
      <p class="not-found__text">{text.text}</p>
      <div class="not-found__actions">
        <ButtonLink href={routes.home[lang]}>{text.home}</ButtonLink>
        <ButtonLink href={`${routes.home[lang]}#projects`} variant="secondary">{text.projects}</ButtonLink>
      </div>
    </Container>
  </main>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: calc(100svh - 4.5rem);
    align-items: center;
    padding-block: var(--space-9);
  }

  .not-found__code {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .not-found h1 {
    margin-top: var(--space-4);
    font-size: var(--text-display);
    line-height: 0.85;
    text-transform: uppercase;
  }

  .not-found__text {
    max-width: 34rem;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }
</style>
