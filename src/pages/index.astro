---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Projects from '../components/sections/Projects.astro';
import Experience from '../components/sections/Experience.astro';
import Container from '../components/ui/Container.astro';
---

<BaseLayout>
  <main id="main-content">
    <Hero />
    <Projects />
    <Experience />

    <section class="page-placeholder" id="about" aria-labelledby="about-title">
      <Container>
        <p class="page-placeholder__index">03</p>
        <h2 id="about-title">Sobre mí</h2>
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
      </Container>
    </section>

    <section class="page-placeholder" id="contact" aria-labelledby="contact-title">
      <Container>
        <p class="page-placeholder__index">04</p>
        <h2 id="contact-title">Contacto</h2>
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
      </Container>
    </section>
  </main>
</BaseLayout>

<style>
  .page-placeholder {
    display: grid;
    min-height: 58svh;
    align-items: center;
    padding-block: var(--space-9);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 4.5rem;
  }

  .page-placeholder__index {
    margin-bottom: var(--space-4);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .page-placeholder h2 {
    font-size: var(--text-2xl);
    letter-spacing: -0.04em;
  }

  .page-placeholder h2 + p {
    max-width: 40rem;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }
</style>
