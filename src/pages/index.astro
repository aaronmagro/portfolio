---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main id="main-content">
    <section class="foundation-preview" aria-labelledby="preview-title">
      <div class="foundation-preview__inner">
        <div class="foundation-preview__copy">
          <p class="foundation-preview__eyebrow">Lorem ipsum · Dolor sit</p>
          <h1 id="preview-title">Lorem ipsum dolor sit amet.</h1>
          <p class="foundation-preview__lead">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer vitae lorem at
            sapien tincidunt luctus eget sed arcu.
          </p>
          <div class="foundation-preview__actions">
            <a class="button button--primary" href="#preview-card">Lorem ipsum</a>
            <a class="button button--secondary" href="#preview-card">Dolor sit</a>
          </div>
        </div>

        <div class="foundation-preview__visual" id="preview-card" aria-hidden="true">
          <div class="foundation-preview__visual-head">
            <span>01</span>
            <span>LOREM</span>
          </div>
          <div class="foundation-preview__visual-shape"></div>
          <div class="foundation-preview__visual-footer">
            <span>Lorem ipsum</span>
            <span>Dolor sit amet</span>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .foundation-preview {
    display: grid;
    min-height: 100svh;
    place-items: center;
    padding-block: var(--space-8);
    overflow: hidden;
  }

  .foundation-preview__inner {
    display: grid;
    width: min(100% - (2 * var(--container-padding)), var(--container-max));
    margin-inline: auto;
    align-items: center;
    gap: clamp(var(--space-7), 7vw, var(--space-10));
  }

  .foundation-preview__copy {
    max-width: 46rem;
  }

  .foundation-preview__eyebrow {
    margin-bottom: var(--space-5);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .foundation-preview h1 {
    max-width: 11ch;
    font-size: var(--text-display);
    letter-spacing: -0.055em;
  }

  .foundation-preview__lead {
    max-width: 40rem;
    margin-top: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .foundation-preview__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }

  .button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    padding-inline: var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button--primary {
    background: var(--color-brand);
    color: #ffffff;
  }

  .button--primary:hover {
    background: var(--color-brand-strong);
  }

  .button--secondary {
    border-color: var(--color-border);
    background: var(--color-surface);
    color: var(--color-heading);
  }

  .button--secondary:hover {
    border-color: var(--color-accent);
  }

  .foundation-preview__visual {
    position: relative;
    min-height: 25rem;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(145deg, rgb(255 255 255 / 0.03), transparent 40%),
      var(--color-surface);
    box-shadow: var(--shadow-elevated);
    overflow: hidden;
  }

  .foundation-preview__visual::after {
    position: absolute;
    width: 18rem;
    height: 18rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    content: '';
    right: -6rem;
    bottom: -8rem;
  }

  .foundation-preview__visual-head,
  .foundation-preview__visual-footer {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .foundation-preview__visual-shape {
    position: absolute;
    inset: 27% 12% auto auto;
    width: min(15rem, 55%);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 38% 62% 57% 43% / 44% 43% 57% 56%;
    background:
      radial-gradient(circle at 35% 30%, rgb(75 180 230 / 0.6), transparent 34%),
      linear-gradient(145deg, var(--color-brand), var(--color-brand-strong));
    filter: saturate(0.9);
    transform: rotate(-12deg);
  }

  .foundation-preview__visual-footer {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    left: var(--space-5);
  }

  @media (min-width: 56rem) {
    .foundation-preview__inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
    }

    .foundation-preview__visual {
      min-height: 34rem;
    }
  }

  @media (max-width: 35rem) {
    .foundation-preview {
      padding-block: var(--space-7);
    }

    .foundation-preview__actions,
    .button {
      width: 100%;
    }

    .foundation-preview__visual {
      min-height: 21rem;
    }
  }
</style>
