---
import '../styles/variables.css';
import '../styles/reset.css';
import '../styles/global.css';
import { siteConfig } from '../config/site';

type SupportedLocale = (typeof siteConfig.locales)[number];

interface Props {
  title?: string;
  description?: string;
  lang?: SupportedLocale;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  lang = siteConfig.defaultLocale,
} = Astro.props;

const skipLinkText = lang === 'en' ? 'Skip to content' : 'Saltar al contenido';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#06131c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f8fa" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem('theme');
        const theme = storedTheme === 'light' || storedTheme === 'dark'
          ? storedTheme
          : window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';

        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skipLinkText}</a>
    <slot />
  </body>
</html>
