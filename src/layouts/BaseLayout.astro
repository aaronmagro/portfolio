---
import '@fontsource/rajdhani/600.css';
import '@fontsource/rajdhani/700.css';
import '@fontsource/chakra-petch/400.css';
import '@fontsource/chakra-petch/500.css';
import '@fontsource/chakra-petch/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/variables.css';
import '../styles/reset.css';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Backdrop from '../components/layout/Backdrop.astro';
import { siteConfig, type SupportedLocale } from '../config/site';
import type { Alternates } from '../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: SupportedLocale;
  // The same page in each language; pages without it are single-language.
  alternates?: Alternates;
}

const {
  lang = siteConfig.defaultLocale,
  title = siteConfig.title[lang],
  description = siteConfig.description[lang],
  alternates,
} = Astro.props;

const alternateUrl = (locale: SupportedLocale) => alternates && new URL(alternates[locale], siteConfig.url).href;

const skipLinkText = lang === 'en' ? 'Skip to content' : 'Saltar al contenido';
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url).href;
// Link previews cache the image by URL, so bump the version whenever og.png changes.
const ogImageUrl = new URL('/og.png?v=2', siteConfig.url).href;
const ogImageAlt =
  lang === 'en'
    ? `${siteConfig.name}, full-stack developer. Projects, experience and CV.`
    : `${siteConfig.name}, desarrollador full-stack. Proyectos, experiencia y CV.`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0d0e10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f2f3ef" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    {alternates && (
      <>
        <link rel="alternate" hreflang="es" href={alternateUrl('es')} />
        <link rel="alternate" hreflang="en" href={alternateUrl('en')} />
        <link rel="alternate" hreflang="x-default" href={alternateUrl('es')} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'es_ES'} />
    {alternates && <meta property="og:locale:alternate" content={lang === 'en' ? 'es_ES' : 'en_GB'} />}
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <slot name="head" />
    {alternates && (
      <script is:inline define:vars={{ lang, alternates }}>
        // First visit with no choice made: follow the browser's language. Crawlers stay on the URL they asked for.
        // Only the Spanish pages redirect: they are the default, while an /en/ link was asked for on purpose.
        (() => {
          if (lang !== 'es') return;
          let chosen = null;
          try {
            chosen = localStorage.getItem('lang');
          } catch {}
          if (chosen || /bot|crawl|spider|slurp|headless|lighthouse|preview/i.test(navigator.userAgent)) return;
          const preferred = (navigator.languages || [navigator.language])
            .map((value) => String(value).slice(0, 2).toLowerCase())
            .find((value) => value === 'es' || value === 'en') || 'en';
          if (preferred !== lang) location.replace(alternates[preferred] + location.hash);
        })();
      </script>
    )}
    <script is:inline>
      (() => {
        let storedTheme = null;
        try {
          storedTheme = localStorage.getItem('theme');
        } catch {}
        const theme = storedTheme === 'light' || storedTheme === 'dark'
          ? storedTheme
          : window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';

        document.documentElement.dataset.theme = theme;

        if (!storedTheme) {
          window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', (event) => {
            let chosen = null;
            try {
              chosen = localStorage.getItem('theme');
            } catch {}
            if (!chosen) document.documentElement.dataset.theme = event.matches ? 'light' : 'dark';
          });
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skipLinkText}</a>
    <Backdrop />
    <Header lang={lang} alternates={alternates} />
    <slot />
    <Footer lang={lang} />
    <script>
      import '../scripts/hud';
      import '../scripts/backdrop';
    </script>
  </body>
</html>
